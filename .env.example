NODE_ENV=development
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
PORT=3002

# Account DB (PostgreSQL)
DATABASE_URL=postgres://account_svc:<DB_PASSWORD_ACCOUNT>@localhost:5432/account_db

# Debe coincidir con el JWT_SECRET del Auth Service, ya que este
# microservicio valida los tokens emitidos por Auth (Gateway/JWT compartido).
JWT_SECRET=
STAFF_JWT_SECRET=

# Claves internas aceptadas: la INTERNAL_API_KEY de ledger-service y la de card-service.
INTERNAL_TRUSTED_KEYS=ledger:<clave-de-ledger>,card:<clave-de-card>

# RabbitMQ (consume el evento identity.verified)
RABBITMQ_URL=amqp://banklite:<RABBITMQ_PASSWORD>@localhost:5672
RABBITMQ_EXCHANGE=banklite.events
RABBITMQ_QUEUE=account-service.identity-verified
