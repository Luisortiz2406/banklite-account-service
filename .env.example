NODE_ENV=development
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
PORT=3002

# Account DB (PostgreSQL)
DATABASE_URL=postgres://account_svc:<DB_PASSWORD_ACCOUNT>@localhost:5432/account_db

# Debe coincidir con el JWT_SECRET del Auth Service, ya que este
# microservicio valida los tokens emitidos por Auth (Gateway/JWT compartido).
JWT_SECRET=
STAFF_JWT_SECRET=

# Claves internas aceptadas: las INTERNAL_API_KEY de ledger, card, payment y transfer.
INTERNAL_TRUSTED_KEYS=ledger:<clave-de-ledger>,card:<clave-de-card>,payment:<clave-de-payment>,transfer:<clave-de-transfer>

# Clave interna PROPIA de account-service. La aceptan auth-service (clave dinámica de
# las llaves Bre-B y cierre del acceso) y savings, deposit y fraud (resumen-cierre).
INTERNAL_API_KEY=
AUTH_SERVICE_URL=http://localhost:3001
KYC_SERVICE_URL=http://localhost:3003

# Cancelar la cuenta: saldo de cada cuenta (ledger, con el token del cliente) y lo que
# impediría cancelar en ahorro, recargas y revisiones de seguridad (red interna).
LEDGER_SERVICE_URL=http://localhost:3006
SAVINGS_SERVICE_URL=http://localhost:3013
DEPOSIT_SERVICE_URL=http://localhost:3014
FRAUD_SERVICE_URL=http://localhost:3009
# El MISMO valor que CLOSURE_TICKET_SECRET de auth-service (firma el ticket de cierre).
# Distinto de JWT_SECRET. Sin ella no se puede cancelar la cuenta (el resto funciona).
CLOSURE_TICKET_SECRET=

# RabbitMQ: consume identity.verified y publica account.closed (outbox)
RABBITMQ_URL=amqp://banklite:<RABBITMQ_PASSWORD>@localhost:5672
RABBITMQ_EXCHANGE=banklite.events
RABBITMQ_QUEUE=account-service.identity-verified

# Opcionales (estos son los valores por defecto).
# Reintentos de un evento que falla antes de mandarlo a la DLQ (<cola>.dlq).
EVENT_MAX_RETRIES=5
EVENT_RETRY_DELAY_MS=10000
# Reintentos de las lecturas entre servicios (GET); las escrituras no se reintentan.
HTTP_READ_RETRIES=1
