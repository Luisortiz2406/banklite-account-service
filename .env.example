NODE_ENV=development
PORT=3002

# Account DB (PostgreSQL)
DATABASE_URL=postgres://banklite:banklite@localhost:5432/account_db

# Debe coincidir con el JWT_SECRET del Auth Service, ya que este
# microservicio valida los tokens emitidos por Auth (Gateway/JWT compartido).
JWT_SECRET=super-secreto-cambiar-en-produccion

# Clave compartida con Ledger para validar cuentas destino en llamadas internas.
INTERNAL_API_KEY=reemplazar-por-clave-interna-compartida

# RabbitMQ (consume el evento identity.verified)
RABBITMQ_URL=amqp://banklite:banklite@localhost:5672
RABBITMQ_EXCHANGE=banklite.events
RABBITMQ_QUEUE=account-service.identity-verified
